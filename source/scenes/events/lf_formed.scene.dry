title: Left-wing Split
new-page: true 
subtitle: The Left's disagreements with our policies have grown too severe.
tags: event
view-if: left_dissent >= 60
on-arrival: {!
// set up the infrastructure
Q.lf_formed = 1;
Q.parties.push('lf');

Q.workers_lf = 10;
Q.workers_spd -= 3;
Q.new_middle_lf = 1;
Q.old_middle_lf = 0;
Q.rural_lf = 0;
Q.unemployed_lf = 2;
Q.catholics_lf = 0;
Q.sorcerers_lf = 5;

Q.workers_other -= 5;
}

// update all records
Q.lf_r = 0;
Q.old_lf_r = 0;
for (var record of Q.election_records) {
    record['lf'] = 0;
}
for (var record of Q.party_support_records) {
    record['lf'] = 0;
}
!}
max-visits: 1

